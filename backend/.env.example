# Copy to backend/.env and fill in values.
# Hackathon keys ONLY work against https://hackathon.api.qloo.com

QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional — narratives fall back to templates when unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

QLOO_TIMEOUT_SECONDS=12
QLOO_MAX_RETRIES=2
QLOO_CACHE_TTL_SECONDS=300
AGENT_MAX_STEPS=4
